# ==============================================================================
# Nexora Environment Configuration Template
# Duplicate this file as .env.local for development, or enter these variables
# into the Vercel Project Settings > Environment Variables for production.
# ==============================================================================

# ------------------------------------------------------------------------------
# Clerk Authentication
# Obtain from Clerk Dashboard: https://dashboard.clerk.com/
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk Redirect & Route Paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding"

# Clerk Webhook Secret (Set in Vercel and Convex Dashboard > Settings > Environment Variables)
CLERK_WEBHOOK_SECRET="whsec_..."

# Optional Clerk Custom Domains / Endpoints (if using custom domains)
# CLERK_FRONTEND_API_URL=""
# CLERK_JWT_ISSUER_DOMAIN=""

# ------------------------------------------------------------------------------
# Convex Backend & Database
# Obtain from Convex Dashboard: https://dashboard.convex.dev/
# In Vercel, connect via the official Convex Vercel Integration or set manually:
# ------------------------------------------------------------------------------
CONVEX_DEPLOYMENT="dev:..."
NEXT_PUBLIC_CONVEX_URL="https://....convex.cloud"
NEXT_PUBLIC_CONVEX_SITE_URL="https://....convex.site"
